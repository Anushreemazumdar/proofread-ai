# AWS Configuration for Amazon Bedrock
# Do NOT place real secrets in this example file.
# Copy this file to .env and provide your AWS credentials/region.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional AWS Credentials if not using IAM roles or AWS CLI profile:
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future S3 / DynamoDB configurations (placeholders)
# S3_BUCKET_NAME=proofread-documents
# DYNAMODB_TABLE_NAME=proofread-analyses
